# ============================================================
# Bot Scraping WhatsApp 3.0 — Environment Configuration
# Copy file ini ke .env dan isi dengan value yang sesuai
# ============================================================

# --- Runtime ---
NODE_ENV=development
BOT_NAME=Rima
SESSION_NAME=rima-session
LOG_LEVEL=info
# Direktori kerja
DIR_AUTH=./auth
DIR_CACHE=./cache
DIR_JOBS=./jobs
DIR_OUTPUTS=./outputs
DIR_REPORTS=./reports
DIR_WATCHES=./watches
DIR_TEMPLATES=./templates

# --- Group Settings ---
# Apakah bot harus di-mention di grup? (true/false)
GROUP_REQUIRE_MENTION=true
# Apakah command diperbolehkan di grup?
GROUP_ALLOW_COMMANDS=true
# Daftar nomor yang diizinkan (kosong = semua diizinkan, pisah koma)
ALLOW_LIST=
# Daftar nomor yang diblokir (pisah koma)
DENY_LIST=
# Nomor admin (pisah koma, format: 628xxx)
ADMIN_PHONES=

# --- Rate Limits ---
# Cooldown per user dalam milidetik
USER_COOLDOWN_MS=3000
# Maksimum job bersamaan
MAX_CONCURRENCY=3
# Timeout per job dalam milidetik
JOB_TIMEOUT_MS=120000
# Limit hasil default dan maksimum
RESULT_LIMIT_DEFAULT=10
RESULT_LIMIT_MAX=50

# --- AI Configuration ---
# Provider utama: openai | gemini | groq | grok
AI_PROVIDER=openai
# Urutan fallback (pisah koma)
AI_FALLBACK_ORDER=openai,gemini,groq,grok
# Auto summary setiap hasil scrape
AUTO_SUMMARY=false
AI_SUMMARY_MAX_ITEMS=20

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Grok (xAI)
GROK_API_KEY=
GROK_MODEL=grok-4

# --- Data Provider Keys ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
S2_API_KEY=
CONTACT_EMAIL=
WIKIPEDIA_LANG=en
GITHUB_TOKEN=
STACKEXCHANGE_SITE=stackoverflow
STACKEXCHANGE_KEY=
YOUTUBE_API_KEY=
CORE_API_KEY=
OPENALEX_EMAIL=
CROSSREF_MAILTO=

# --- Puppeteer / Brave ---
# Path ke Brave browser (kosongkan untuk auto-detect)
BRAVE_EXECUTABLE=
# Headless mode (false = tampilkan browser)
PUPPETEER_HEADLESS=false
# Maks halaman concurrent di Puppeteer
PUPPETEER_MAX_PAGES=3

# --- Cache ---
CACHE_TTL_SECONDS=300
# Circuit breaker: berapa kali gagal sebelum open
CB_FAILURE_THRESHOLD=5
# Durasi circuit breaker open (ms)
CB_RESET_TIMEOUT_MS=60000

# --- Output ---
# Format output default: json | csv | excel | txt | html
OUTPUT_FORMAT_DEFAULT=json
# Threshold ukuran file untuk auto-ZIP (bytes)
ZIP_THRESHOLD_BYTES=5242880
# Maks file dalam satu pengiriman sebelum di-ZIP
ZIP_FILE_COUNT_THRESHOLD=5
